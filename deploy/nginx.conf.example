# Este archivo se incluye dentro del contexto http de nginx.conf.
# Sustituye PUBLIC_IP antes de habilitarlo. Los logs no incluyen query strings.
log_format buildcorp_safe '$remote_addr $request_method $uri $status';
server {
    listen 80;
    server_name PUBLIC_IP;
    client_max_body_size 1m;
    access_log /var/log/nginx/buildcorp_access.log buildcorp_safe;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
