[Unit]
Description=BuildCorp Django (Webpay integration only)
After=network.target postgresql.service
[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/buildcorp
ExecStart=/home/ubuntu/buildcorp/.venv/bin/gunicorn --config deploy/gunicorn.conf.py buildcorp.wsgi:application
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
[Install]
WantedBy=multi-user.target
